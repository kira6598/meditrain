<Window x:Class="QuanLyDaoTao.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MediTrain — Quản lý đào tạo y tế &amp; CME" Height="860" Width="1440" MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#123C41"><DockPanel Margin="18,28,18,20">
            <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30"><StackPanel Orientation="Horizontal"><Border CornerRadius="9" Background="#20B8A8" Width="36" Height="36"><TextBlock Text="+" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border><TextBlock Text="MediTrain" FontSize="23" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="QUẢN LÝ ĐÀO TẠO Y TẾ" Foreground="#9EBFC1" FontSize="10" Margin="0,12,0,0"/></StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="10,24,10,0"><Border Background="#205057" CornerRadius="8" Padding="11"><StackPanel><TextBlock Text="●  Dữ liệu cục bộ" Foreground="#7CE3CA" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="SQLite · Hoạt động ngoại tuyến" Foreground="#B3CCCE" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><TextBlock x:Name="SidebarCount" Foreground="#9EBFC1" FontSize="11" Margin="0,13,0,0"/><TextBlock Text="Phiên bản 1.5.2  /  Windows" Foreground="#709A9D" FontSize="10" Margin="0,7,0,0"/></StackPanel>
            <StackPanel x:Name="Navigation"/>
        </DockPanel></Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1" Padding="28,16"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="Nạp dữ liệu mẫu" Click="Sample_Click"/><Button Content="Sao lưu dữ liệu" Click="Backup_Click" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="KHÔNG GIAN LÀM VIỆC" Foreground="#82939F" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="HeaderTitle" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="28,24,28,18"/>
            <Border Grid.Row="2" Background="#EAF0F3" Padding="28,7"><DockPanel><TextBlock x:Name="StatusText" FontSize="11" Foreground="#607784"/><TextBlock Text="Mục tiêu theo dõi: 12 tiết/năm · 48 tiết/2 năm" FontSize="10" Foreground="#738793" HorizontalAlignment="Right"/></DockPanel></Border>
        </Grid>
    </Grid>
</Window>
